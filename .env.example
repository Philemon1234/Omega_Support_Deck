VITE_API_URL=http://localhost:5000/api

# Backend / UG SMS
PORT=5000
SMS_PROVIDER=ug_sms
SMS_MOCK=true
UGSMS_API_KEY=your_ugsms_api_key_here
UGSMS_API_URL=https://ugsms.com/api/v2/sms/send
# Sender IDs are commonly limited to 11 alphanumeric characters.
# "Omega Wi-Fi" will be sent as OMEGAWIFI.
UGSMS_SENDER_ID=OMEGAWIFI
UGSMS_TIMEOUT_MS=15000
FRONTEND_URL=http://localhost:5173
